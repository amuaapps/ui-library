# Example Terraform variables file
# Copy this to terraform.tfvars and customize for your deployment

# Required Variables
project_name = "ui-library"
environment  = "dev"
region       = "us-east-1"

# Optional Variables (uncomment and customize as needed)

# Enable blue/green deployment (default: true)
# enable_blue_green = true

# Enable CloudFront CDN (default: true)
# enable_cdn = true

# Custom domain name (requires route53_zone_id)
# custom_domain_name = "storybook.example.com"
# route53_zone_id    = "Z1234567890ABC"

# Log retention period in days (default: 30)
# retention_policy_days = 30

# Additional resource tags
# tags = {
#   Project     = "UI Library"
#   Owner       = "platform-team@example.com"
#   CostCenter  = "Engineering"
# }

# Active environment for blue/green switch (default: blue)
# active_environment = "blue"
