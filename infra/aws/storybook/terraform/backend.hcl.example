# Example backend configuration file
# Copy this to backend.hcl and fill in your values
# DO NOT commit backend.hcl with real values to git

bucket         = "your-terraform-state-bucket"
key            = "ui-library/storybook/dev/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "terraform-state-locks"
encrypt        = true

# Optional: use workspace key prefix for multiple environments
# workspace_key_prefix = "workspaces"
